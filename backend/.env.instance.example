# The DEPLOYED store, as this machine reaches it. Copy to `.env.instance` and fill in.
#
# `backend/.env` is the local development environment and is not touched by any of this. This
# file is the other one: what the `instance:*` tasks read so that a CLI running here writes
# there. Variables set from it win over `.env`, which is what lets the two coexist.
#
# It is gitignored, and it holds a database password and a Clerk secret. Nothing here is
# needed to develop, run or test anything — only to prepare an instance, which happens once.
#
# The order these are used in is `backend/ENVIRONMENT.md`. Read that first; this file is its
# second half, not a substitute for it.

# --- Releasing the code ---------------------------------------------------
# Where `task deploy:api` publishes the API image, and where Render pulls it from. Neither
# host builds this repository, so the image is built here and released explicitly.
#
# **Nothing has to exist yet.** This is a name you choose, and the first push creates the
# package under it. Three things it has to be:
#
#   - **All lowercase.** Docker refuses an uppercase repository name, and GitHub usernames
#     often carry one, so the account `UserName` publishes to `ghcr.io/username/…`.
#   - **Under an account you control.** Any GitHub account: the namespace needs no relation to
#     the repository the code comes from, and pushing needs a *classic* token with
#     `write:packages` (GHCR does not accept fine-grained ones).
#   - **The same string Render is pointed at**, since nothing checks that the two agree.
#
# What follows the slash is yours to pick. Check after the first push that the package is
# **private** — it is by default, and the image carries this repository's source. Render pulls
# it with a second classic token scoped `read:packages`, declared on the service, not here.
IMAGE_REPO=ghcr.io/<your github user>/learnpack-evals-api
# Render's deploy hook for that service (Settings -> Deploy Hook). Pushing an image does not
# release it: an image-backed service never redeploys on its own. Leave empty to release by
# hand from the dashboard instead.
RENDER_DEPLOY_HOOK=

# --- The store ------------------------------------------------------------
# Neon. The psycopg3 prefix and `?sslmode=require` are both required.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Identity -------------------------------------------------------------
# Never `local` here: it disables authentication, and `Settings` refuses to combine it with a
# database that is not on this machine (ADR-0008), so a mistake stops the command rather than
# writing anything.
AUTH_MODE=clerk
# The instance `setup-clerk-jwt-template` configures and `invite-assessor` invites into.
CLERK_SECRET_KEY=

# The admin these acts are attributed to. They must have signed in already: an act names its
# author (ADR-0042) and the row has to exist to be named.
ADMIN_EMAIL=

# --- What the campaign is measured on -------------------------------------
# The generator lineage every course of this campaign came from. Resolved, never created by
# these tasks (ADR-0031).
GENERATOR_NAME=learnpack-generator

# LearnpackV1 courses, registered from a spreadsheet of URLs: first column, everything else
# ignored. The version they are attributed to is declared here rather than read off anything,
# so it is reviewed once instead of typed per run.
COURSES_V1_CSV=./courses-v1.csv
GENERATOR_VERSION_V1=1.0.0

# LearnpackV2 courses, registered from a tree on this machine — the generator's own output,
# which is not served anywhere. The key names a root declared in LOCAL_SOURCE_ROOTS below and
# the version is read off each folder's name.
V2_ROOT=generated
LOCAL_SOURCE_ROOTS=generated=D:\generator\datasets\generated
# Where the local API serves that tree. It has to be the API that is actually running: these
# registrations mint locators into it and fetch through them.
LOCAL_SOURCES_BASE_URL=http://localhost:8000/sources

# Where the courses are deployed for a human to open. Two columns, `external_id,url`
# (ADR-0028, ADR-0054). Separate from registration because a course is usually deployed after
# it is registered, and a deployment is a statement about the world right now.
DEPLOYMENTS_CSV=./deployments.csv

# --- Backups --------------------------------------------------------------
# Where `instance:dump` writes. OUTSIDE the repository: it is the identified record of what a
# panel answered, and the only copy of it.
DUMP_DIR=../../learnpack-evals-dumps
