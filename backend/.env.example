# --- Database (Neon) -------------------------------------------------------
# Neon requires SSL. Use the psycopg3 driver prefix.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Test database (local) -------------------------------------------------
# The test suite runs here instead of DATABASE_URL when this is set. Neon is ~150 ms per
# query from Buenos Aires and the suite is latency-bound, so running it locally takes it
# from ~10 min to under a minute. Start it with `docker compose up -d`.
# The suite migrates and seeds this database by itself.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/learnpack_evals_test

# --- Clerk (ADR-0004) ------------------------------------------------------
# Issuer of the JWT template, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Usually <CLERK_ISSUER>/.well-known/jwks.json — leave empty to derive it from the issuer.
CLERK_JWKS_URL=
# Only needed for the Management API (evaluator invitations). Not used to verify tokens.
CLERK_SECRET_KEY=

# --- Admin bootstrap (ADR-0007) --------------------------------------------
# Comma-separated emails created as admin on their FIRST login. Bootstrap only: it does NOT
# promote or demote anyone who already exists — logging in never changes a role. To change an
# existing assessor's role use `python -m app.cli set-role`.
ADMIN_EMAILS=

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins allowed by CORS (the Netlify frontend).
ALLOWED_ORIGINS=http://localhost:3000

ENVIRONMENT=development
