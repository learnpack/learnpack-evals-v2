# This file is the LOCAL development template (it matches frontend/.env.local.example, which
# also ships in local mode). Copy it as-is and the app runs with no accounts and no cloud.
# Production does not use it: Render sets its own environment variables.

# --- Auth mode (ADR-0008) --------------------------------------------------
# `local` disables authentication: the identity is whatever `X-Dev-User: <email>` says. Only
# this mode enables `python -m app.cli seed-demo` and `GET /dev/identities`.
# `clerk` (the code default) verifies the session JWT against Clerk's JWKS — that is what any
# real environment uses.
# `local` is refused when ENVIRONMENT=production or when DATABASE_URL is not local: the
# process does not start. Any other value is a config error and also fails to boot.
AUTH_MODE=local

# --- Database --------------------------------------------------------------
# Local development database, started by `docker compose up -d`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/learnpack_evals_dev
# Neon (requires SSL, psycopg3 driver prefix) — for a real environment, with AUTH_MODE=clerk:
# DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Test database (local) -------------------------------------------------
# The test suite runs here instead of DATABASE_URL when this is set. Neon is ~150 ms per
# query from Buenos Aires and the suite is latency-bound, so running it locally takes it
# from ~10 min to under a minute. Start it with `docker compose up -d`.
# The suite migrates and seeds this database by itself.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/learnpack_evals_test

# --- Clerk (ADR-0004) — not needed with AUTH_MODE=local ---------------------
# Issuer of the JWT template, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Usually <CLERK_ISSUER>/.well-known/jwks.json — leave empty to derive it from the issuer.
CLERK_JWKS_URL=
# Only needed for the Management API (evaluator invitations). Not used to verify tokens.
CLERK_SECRET_KEY=

# --- Admin bootstrap (ADR-0007) --------------------------------------------
# Comma-separated emails created as admin on their FIRST login. Bootstrap only: it does NOT
# promote or demote anyone who already exists — logging in never changes a role. To change an
# existing assessor's role use `python -m app.cli set-role`.
ADMIN_EMAILS=

# --- LLM transport (ADR-0034) ----------------------------------------------
# ACCESS only, never identity: which model judges is pinned in each assessor's code, and
# changing it there is a new assessor version. Only assessors that carry LLM tasks need the
# key (`drafts-hybrid`); without it, `evaluate` with such an assessor fails loudly and
# persists nothing. Any OpenAI-compatible endpoint works as the base URL.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Local sources (ADR-0027 §5, ADR-0035) ---------------------------------
# Folders of generated courses you can register from, browsable at /admin/contents/import.
# Only read under AUTH_MODE=local. The repo's own `courses/` tree is always available and is
# NOT declared here; this variable is for trees that live anywhere else.
#
# Each entry is <name>=<folder>, comma-separated:
#   <name>    a short name YOU choose for the tree. It becomes part of the URL the tree is
#             served at (/sources/<name>/...) and is stored inside every locator registered
#             from it, so pick one and keep it: renaming it strands the courses already
#             registered. Must match [a-z0-9._-]+ and cannot be `courses`.
#   <folder>  where that tree lives on this machine.
#
# One tree, which you decide to call `runs`:
# LOCAL_SOURCE_ROOTS=runs=D:\generator\out
# Two trees:
# LOCAL_SOURCE_ROOTS=runs=D:\generator\out,archive=/srv/old-courses
#
# A folder that does not exist is fine — it is reported as absent and skipped. An entry that
# is not `<name>=<folder>` stops the process, because nothing could act on it.

# Where those trees are served. Both have these exact defaults, so leave them out unless the
# API runs on another port or host — the locators would then point at a URL nothing serves,
# and registering refuses. Changing LOCAL_PACKAGES_BASE_URL does NOT move the courses already
# registered from `courses/`: their locators still point at the old one, forever.
# LOCAL_PACKAGES_BASE_URL=http://localhost:8000/packages
# LOCAL_SOURCES_BASE_URL=http://localhost:8000/sources

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins allowed by CORS (the Netlify frontend).
ALLOWED_ORIGINS=http://localhost:3000

ENVIRONMENT=development
