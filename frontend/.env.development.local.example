# The development environment of the console — copy to `.env.development.local`.
#
# The name is the whole point, and it is a mode and not a machine: Next reads
# `.env.development.local` under `next dev` and NEVER under `next build`, while a file named
# `.env.local` is read by both. A deploy builds here, on a developer's machine, in the
# directory this file sits in — so under the other name every value below is a value the
# deploy can pick up. Not all of them: an env file never overwrites a variable the process
# already has, so what Netlify declares wins. What it does NOT declare is the hole, and the
# file fills it, silently, and then travels inside the deployed server function and is read
# there again at runtime. Under this name there is no hole to fill.
#
# --- Auth mode (ADR-0008) --------------------------------------------------
# `local` = no authentication at all: you pick who to sign in as from a list of seeded users.
# Anything else (or unset) = Clerk, the real provider.
# The backend must run with the matching AUTH_MODE=local.
NEXT_PUBLIC_AUTH_MODE=local

# --- Backend ---------------------------------------------------------------
# The API base URL. Locally the backend runs on :8000; in prod use the Render URL.
NEXT_PUBLIC_API_URL=http://localhost:8000


#############################################################################
# --- NOT NEEDED WHEN AUTH_MODE=local ---------------------------------------
#############################################################################
# --- Clerk (ADR-0004) ------------------------------------------------------
# From the Clerk dashboard → API keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# Clerk routing: keep the app on our own /sign-in page.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/accept-invitation

# Name of the Clerk JWT template that carries email/name claims (see note below).
# The frontend sends getToken({ template: <this> }) so the backend can read the claims.
# NEXT_PUBLIC_CLERK_JWT_TEMPLATE=learnpack-evals

# --- IMPORTANT: Clerk JWT template -----------------------------------------
# Clerk's DEFAULT session token does NOT carry email/name. Create a JWT template in the
# Clerk dashboard (name it to match NEXT_PUBLIC_CLERK_JWT_TEMPLATE above) with:
#   {
#     "email": "{{user.primary_email_address}}",
#     "name": "{{user.full_name}}",
#     "email_verified": "{{user.email_verified}}"
#   }
# The backend reads these claims to populate the Assessor and to decide the first admin's
# role (ADMIN_EMAILS, ADR-0007). The template MUST exist BEFORE the first admin logs in,
# or they are created as an evaluator (safe degrade) and the allowlist won't rescue them.
# `email_verified` gates redeeming an invitation (ADR-0049): without it every invitation
# stays pending and people get the default role instead of the one they were invited with.
# Invite-only access is configured in Clerk (Restrictions → Allowlist / invitations).
